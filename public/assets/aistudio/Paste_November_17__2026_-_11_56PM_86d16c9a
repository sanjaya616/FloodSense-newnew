        try {
          parsed = JSON.parse(responseText);
        } catch {
          throw new Error('Gemini returned malformed non-JSON output');
        }

        if (
          typeof parsed.confidenceScore !== 'number' ||
          !Number.isFinite(parsed.confidenceScore) ||
          parsed.confidenceScore < 0 ||
          parsed.confidenceScore > 100
        ) {
          throw new Error('Gemini output omitted a valid numeric confidenceScore (0-100)');
        }

        const confidenceScore = Number(parsed.confidenceScore.toFixed(1));
        const validAssessments = new Set([
          'Possible Flooding Detected',
          'No Clear Flooding Detected',
          'Uncertain Image',
          'Invalid or Unusable Photograph',
        ]);
        const aiAssessment = validAssessments.has(parsed.assessment)
          ? parsed.assessment
          : parsed.hasVisibleFlooding === true
          ? 'Possible Flooding Detected'
          : 'Uncertain Image';

        lastAiSuccessTime = new Date().toISOString();
        lastAiError = null;

        return {
          statusCode: 200,
          payload: {
            method: GEMINI_METHOD_LABEL,
            modelName: GEMINI_VERIFY_MODEL,
            aiStatus: 'COMPLETED',
            hasVisibleFlooding: Boolean(parsed.hasVisibleFlooding),
            aiAssessment,
            officialStatus: 'Under Review',
            confidence: confidenceScore,
            explanation:
              typeof parsed.detailedExplanation === 'string' && parsed.detailedExplanation.trim()
                ? parsed.detailedExplanation
                : `Visual inspection indicated ${aiAssessment.toLowerCase()}.`,
            uncertainty:
              typeof parsed.uncertaintyNotes === 'string' && parsed.uncertaintyNotes.trim()
                ? parsed.uncertaintyNotes
                : 'Optical assessment subject to camera angle and lighting conditions. Field officer verification required.',
            waterLevelEstimated: parsed.observedWaterLevel || params.waterLevel,
            roadAccessibilityEstimated: parsed.observedAccessibility || 'Uncertain',
            humanVerificationRequired: true,
            timestamp: ts,
            disclaimer,
          },
        };
      } catch (err: any) {
        lastAiError = err?.message || 'Gemini inference error';
        return {
          statusCode: 502,
          payload: {
            method: GEMINI_METHOD_LABEL,
            modelName: GEMINI_VERIFY_MODEL,
            aiStatus: 'FAILED',
            hasVisibleFlooding: false,
            aiAssessment: 'AI Processing Failed',
            officialStatus: 'Under Review',
            confidence: null,
            explanation: `Gemini AI processing failed (${lastAiError}). Your flood report has been saved safely and queued for officer review.`,
            uncertainty: 'Live AI model failed to return a valid structured assessment.',
            waterLevelEstimated: params.waterLevel,
            roadAccessibilityEstimated: 'Uncertain',
            humanVerificationRequired: true,
            timestamp: ts,
            disclaimer,
          },
        };
      }
    };

    const result = await evaluateWithGeminiHelper({
      cleanBase64,
      detectedMime,
      waterLevel,
      floodType,
      description,
    });
    return res.status(result.statusCode).json(result.payload);
  });

  // --- API ROUTE 3B: Authenticated Retry AI Assessment on Existing Firestore Report ---
  app.post('/api/reports/:reportId/retry-ai', aiRateLimiter, async (req, res) => {
    const { verifyIdToken, firestore } = resolveAdminServices();
    if (!verifyIdToken || !firestore) {
      return res.status(503).json({
        ok: false,
        error: 'FIREBASE_ADMIN_UNAVAILABLE: Retry AI persistence requires Firebase Admin credentials.',
      });
    }

    const authHeader = req.headers.authorization;
    const token = authHeader?.startsWith('Bearer ') ? authHeader.slice(7).trim() : null;
    if (!token) {
      return res.status(401).json({ ok: false, error: 'Missing Authorization Bearer token.' });
    }

    let authUid = '';
    let authRole: 'officer' | 'citizen' = 'citizen';
    try {
      const decoded = await verifyIdToken(token);
      authUid = decoded.uid;
      const roleInfo = await resolveAuthoritativeRole(decoded, firestore);
      authRole = roleInfo.role;
    } catch (err: any) {
      return res.status(401).json({ ok: false, error: err?.message || 'Invalid Firebase authentication token.' });
    }

    const { reportId } = req.params;
    if (!reportId || typeof reportId !== 'string' || reportId.length > 100) {
      return res.status(400).json({ ok: false, error: 'Invalid reportId parameter.' });
    }

    try {
      const reportRef = firestore.collection('reports').doc(reportId);
      const reportSnap = await reportRef.get();
      if (!reportSnap.exists) {
        return res.status(404).json({ ok: false, error: `Report ${reportId} not found.` });
      }

      const reportData = reportSnap.data() as FloodReport;
      if (reportData.reporterId !== authUid && authRole !== 'officer') {
        return res.status(403).json({ ok: false, error: 'Forbidden: you do not have permission to retry AI on this report.' });
      }

      const disclaimer =
        'AI image assessment is an assistive early warning signal only. Official verification requires authorized emergency officer confirmation.';
      const timestamp = new Date().toISOString();

      let imageBuffer: Buffer | null = null;
      let detectedMime: 'image/jpeg' | 'image/png' | 'image/webp' | null = null;

      const customImage = typeof req.body?.customImage === 'string' ? req.body.customImage.trim() : '';
      if (customImage) {
        const cleanBase64 = customImage.replace(/^data:image\/[a-zA-Z0-9+.-]+;base64,/i, '').trim();
        imageBuffer = Buffer.from(cleanBase64, 'base64');
      } else {
        const evidenceCol =
          typeof reportRef.collection === 'function' ? reportRef.collection('evidence') : null;
        let evidenceDocData: Record<string, any> | null = null;

        if (evidenceCol && typeof reportData.primaryEvidenceId === 'string' && reportData.primaryEvidenceId.trim()) {
          const primarySnap = await evidenceCol.doc(reportData.primaryEvidenceId.trim()).get();
          if (primarySnap.exists) {
            evidenceDocData = primarySnap.data() || null;
          }
        }

        if (evidenceCol && !evidenceDocData && typeof evidenceCol.limit === 'function') {
          const evidenceListSnap = await evidenceCol.limit(1).get();
          if (evidenceListSnap && !evidenceListSnap.empty && evidenceListSnap.docs?.[0]) {
            evidenceDocData = evidenceListSnap.docs[0].data() || null;
          }
        }

        if (evidenceDocData && typeof evidenceDocData.base64Data === 'string' && evidenceDocData.base64Data.trim()) {
          const cleanBase64 = evidenceDocData.base64Data
            .replace(/^data:image\/[a-zA-Z0-9+.-]+;base64,/i, '')
            .trim();
          imageBuffer = Buffer.from(cleanBase64, 'base64');
        } else if (typeof reportData.imageUrl === 'string' && reportData.imageUrl.startsWith('https://')) {
          return res.status(400).json({
            ok: false,
            error: 'External Storage image URLs are disabled on Spark-plan deployments. Please upload photo evidence to Firestore.',
          });
        } else if (typeof reportData.imageUrl === 'string' && reportData.imageUrl.startsWith('data:image/')) {
          const cleanBase64 = reportData.imageUrl.replace(/^data:image\/[a-zA-Z0-9+.-]+;base64,/i, '').trim();
          imageBuffer = Buffer.from(cleanBase64, 'base64');
        }
      }

      let aiDetails: Record<string, any>;
      if (!imageBuffer || imageBuffer.length === 0) {
        aiDetails = {
          method: 'No Visual Analysis Run (Text-Only Report)',
          modelName: 'None',
          aiStatus: 'NOT_RUN',
          hasVisibleFlooding: false,
          aiAssessment: 'AI Not Run (No Image)',
          officialStatus: 'Under Review',
          confidence: null,
          explanation: 'No photograph was attached to this report. AI visual verification was not run.',
          uncertainty: 'Visual confirmation unavailable: text-only submission.',
          waterLevelEstimated: reportData.waterLevel,
          roadAccessibilityEstimated: 'Uncertain',
          humanVerificationRequired: true,
          timestamp,
          disclaimer,
        };
      } else {
        if (imageBuffer.length > MAX_IMAGE_BYTES) {
          return res.status(413).json({ ok: false, error: 'Image size exceeds maximum 5 MB server limit.' });
        }
        detectedMime = detectImageMimeFromBuffer(imageBuffer);
        if (!detectedMime) {
          return res.status(400).json({ ok: false, error: 'Stored or uploaded photograph is not a valid JPEG, PNG, or WEBP binary.' });
        }

        const geminiKey = getGeminiKey();
        if (!geminiKey) {
          aiDetails = {
            method: 'Gemini AI (Unconfigured)',
            modelName: GEMINI_VERIFY_MODEL,
            aiStatus: 'UNCONFIGURED',
            hasVisibleFlooding: false,
            aiAssessment: 'AI Verification Not Configured',
            officialStatus: 'Under Review',
            confidence: null,
            explanation: 'Server GEMINI_API_KEY is not configured. Report remains queued for manual officer verification.',
            uncertainty: 'Automated visual assessment unavailable until GEMINI_API_KEY is configured on the server.',
            waterLevelEstimated: reportData.waterLevel,
            roadAccessibilityEstimated: 'Uncertain',
            humanVerificationRequired: true,
            timestamp,
            disclaimer,
          };
        } else {
          try {
            const ai = overrides.aiClientFactory
              ? overrides.aiClientFactory(geminiKey)
              : new GoogleGenAI({
                  apiKey: geminiKey,
                  httpOptions: { headers: { 'User-Agent': 'aistudio-build' } },
                });
            const prompt = `You are the AI verification engine for FloodSense, an urban disaster management platform for Colombo, Sri Lanka.
Analyze this submitted photograph carefully.
Citizen submission context:
- Claimed Water Level: "${reportData.waterLevel}"
- Flood Type: "${reportData.floodType}"
- Description: "${String(reportData.description || '').slice(0, 600)}"
Provide confidenceScore strictly as a percentage from 0 to 100.`;
            const geminiRes = await ai.models.generateContent({
              model: GEMINI_VERIFY_MODEL,
              contents: {
                parts: [
                  { inlineData: { mimeType: detectedMime, data: imageBuffer.toString('base64') } },
                  { text: prompt },
                ],
              },
              config: {
                abortSignal: AbortSignal.timeout(30000),
                thinkingConfig: { thinkingLevel: ThinkingLevel.LOW },
                responseMimeType: 'application/json',
                responseSchema: {
                  type: Type.OBJECT,
                  properties: {
                    hasVisibleFlooding: { type: Type.BOOLEAN },
                    confidenceScore: { type: Type.NUMBER },
                    assessment: {
                      type: Type.STRING,
                      enum: [
                        'Possible Flooding Detected',
                        'No Clear Flooding Detected',
                        'Uncertain Image',
                        'Invalid or Unusable Photograph',
                      ],
                    },
                    observedWaterLevel: { type: Type.STRING },
                    observedAccessibility: { type: Type.STRING },
                    detailedExplanation: { type: Type.STRING },
                    uncertaintyNotes: { type: Type.STRING },
                  },
                  required: ['hasVisibleFlooding', 'confidenceScore', 'assessment', 'detailedExplanation', 'uncertaintyNotes'],
                },
              },
            });
            const parsed = JSON.parse(geminiRes.text || '{}');
            if (typeof parsed.confidenceScore !== 'number' || !Number.isFinite(parsed.confidenceScore)) {
              throw new Error('Gemini output omitted numeric confidenceScore');
            }
            const confidenceScore = Number(parsed.confidenceScore.toFixed(1));
            lastAiSuccessTime = new Date().toISOString();
            lastAiError = null;
            aiDetails = {
              method: GEMINI_METHOD_LABEL,
              modelName: GEMINI_VERIFY_MODEL,
              aiStatus: 'COMPLETED',
              hasVisibleFlooding: Boolean(parsed.hasVisibleFlooding),
              aiAssessment: parsed.assessment || 'Uncertain Image',
              officialStatus: 'Under Review',
              confidence: confidenceScore,
              explanation: parsed.detailedExplanation || 'Visual analysis completed.',
              uncertainty: parsed.uncertaintyNotes || 'Field officer verification required.',
              waterLevelEstimated: parsed.observedWaterLevel || reportData.waterLevel,
              roadAccessibilityEstimated: parsed.observedAccessibility || 'Uncertain',
              humanVerificationRequired: true,
              timestamp,
              disclaimer,
            };
          } catch (aiErr: any) {
            lastAiError = aiErr?.message || 'Gemini inference failed';
            aiDetails = {
              method: GEMINI_METHOD_LABEL,
              modelName: GEMINI_VERIFY_MODEL,
              aiStatus: 'FAILED',
              hasVisibleFlooding: false,
              aiAssessment: 'AI Processing Failed',
              officialStatus: 'Under Review',
              confidence: null,
              explanation: `AI vision retry failed (${lastAiError}). Report remains safely queued for officer inspection.`,
              uncertainty: 'Live AI model failed to return a valid assessment.',
              waterLevelEstimated: reportData.waterLevel,
              roadAccessibilityEstimated: 'Uncertain',
              humanVerificationRequired: true,
              timestamp,
              disclaimer,
            };
          }
        }
      }

      const nextStatus =
        aiDetails.aiStatus === 'COMPLETED' && reportData.incidentStatus === 'Submitted'
          ? 'Under Review'
          : reportData.incidentStatus;

      const historyEntry = {
        status: nextStatus,
        timestamp,
        authorName: aiDetails.method,
        note:
          aiDetails.aiStatus === 'COMPLETED'
            ? `Retry AI Assessment completed: "${aiDetails.aiAssessment}" (${aiDetails.confidence ?? 'N/A'}% confidence). Human officer review required.`
            : `Retry AI Assessment (${aiDetails.aiStatus}): ${aiDetails.explanation}`,
      };

      const nextHistory = [...(Array.isArray(reportData.statusHistory) ? reportData.statusHistory : []), historyEntry];

      await reportRef.set(
        {
          incidentStatus: nextStatus,
          aiConfidence: aiDetails.confidence,
          aiClassification: aiDetails.aiAssessment,
          aiStatus: aiDetails.aiStatus,
          aiVerificationDetails: aiDetails,
          statusHistory: nextHistory,
          updatedAt: timestamp,
        },
        { merge: true }
      );

      await firestore
        .collection('status_history')
        .doc(`${reportId}_h_${Date.now()}`)
        .set({
          reportId,
          citizenUid: reportData.reporterId || '',
          ...historyEntry,
        });

      return res.json({
        ok: true,
        report: {
          ...reportData,
          incidentStatus: nextStatus,
          aiConfidence: aiDetails.confidence,
          aiClassification: aiDetails.aiAssessment,
          aiStatus: aiDetails.aiStatus,
          aiVerificationDetails: aiDetails,
          statusHistory: nextHistory,
        },
      });
    } catch (err: any) {
      return res.status(500).json({ ok: false, error: err?.message || 'Failed to retry AI assessment.' });
    }
  });

  // --- API ROUTE 4: Citywide Near-Duplicate Check ---
  app.post('/api/reports/check-duplicate', syncRateLimiter, async (req, res) => {
    const { lat, lng, timestamp } = req.body || {};
    if (typeof lat !== 'number' || typeof lng !== 'number' || !validateCoordinates(lat, lng)) {
      return res.status(400).json({ error: 'Valid coordinates required.' });
    }

    const { verifyIdToken, firestore } = resolveAdminServices();
    if (!verifyIdToken || !firestore) {
      return res.json({
        ok: true,
        checkedCitywide: false,
        duplicateCheckStatus: 'LOCAL_ONLY',
        isDuplicate: false,
        duplicateOfId: null,
        message: 'Server Admin Firestore is unconfigured in this environment; client local safety check applied.',
      });
    }

    const authCheck = await verifyRequestAuth(req);
    if (!authCheck.ok) {
      return res.status(authCheck.status || 401).json({ error: authCheck.error || 'Unauthorized' });
    }

    const ts = typeof timestamp === 'string' && !isNaN(Date.parse(timestamp)) ? timestamp : new Date().toISOString();
    try {
      const cutoffIso = new Date(Date.now() - 15 * 60 * 1000).toISOString();
      const recentSnap = await firestore
        .collection('reports')
        .where('timestamp', '>=', cutoffIso)
        .get();

      let matchedId: string | null = null;
      for (const docSnap of recentSnap.docs) {
        const data = docSnap.data();
        if (areReportsDuplicate({ lat: data.lat, lng: data.lng, timestamp: data.timestamp }, { lat, lng, timestamp: ts })) {
          matchedId = data.id || docSnap.id;
          break;
        }
      }

      return res.json({
        ok: true,
        checkedCitywide: true,
        duplicateCheckStatus: 'VERIFIED_CITYWIDE',
        isDuplicate: Boolean(matchedId),
        duplicateOfId: matchedId,
      });
    } catch (err: any) {
      return res.status(500).json({ error: err?.message || 'Citywide duplicate check failed.' });
    }
  });

  // --- API ROUTE 4B: Authorized Atomic Delete of Report ---
  app.delete('/api/reports/:reportId', syncRateLimiter, async (req, res) => {
    const { verifyIdToken, firestore } = resolveAdminServices();
    if (!verifyIdToken || !firestore) {
      return res.status(501).json({
        ok: false,
        reason: 'ADMIN_SDK_NOT_CONFIGURED',
        error: 'Server Admin SDK unavailable; client Firestore deletion path required.',
      });
    }

    const authCheck = await verifyRequestAuth(req);
    if (!authCheck.ok) {
      return res.status(authCheck.status || 401).json({ ok: false, error: authCheck.error || 'Unauthorized' });
    }

    const { reportId } = req.params;
    if (!reportId || typeof reportId !== 'string' || reportId.length > 100) {
      return res.status(400).json({ ok: false, error: 'Invalid reportId parameter.' });
    }

    try {
      const reportRef = firestore.collection('reports').doc(reportId);
      const reportSnap = await reportRef.get();
      if (!reportSnap.exists) {
        return res.status(404).json({ ok: false, error: `Report ${reportId} not found.` });
      }

      const reportData = reportSnap.data() as FloodReport;
      const isOwner = Boolean(authCheck.uid && reportData.reporterId === authCheck.uid);
      const isOfficer = authCheck.role === 'officer';
      const ownerDeletableStatuses = ['Submitted', 'Under Review', 'More Info Requested'];

      if (!isOfficer && (!isOwner || !ownerDeletableStatuses.includes(reportData.incidentStatus))) {
        return res.status(403).json({
          ok: false,
          error: 'Forbidden: only officers or owners of unverified reports can delete this report.',
        });
      }

      const evidenceSnap = await reportRef.collection('evidence').get();
      const batch = firestore.batch();
      let deletedEvidenceCount = 0;
      evidenceSnap.docs.forEach((docSnap: any) => {
        batch.delete(docSnap.ref);
        deletedEvidenceCount += 1;
      });
      batch.delete(reportRef);
      batch.delete(firestore.collection('public_reports').doc(reportId));
      await batch.commit();

      return res.json({
        ok: true,
        deletedReportId: reportId,
        deletedEvidenceCount,
      });
    } catch (err: any) {
      return res.status(500).json({ ok: false, error: err?.message || 'Failed to delete report and evidence.' });
    }
  });

  // --- API ROUTE 5: Trusted Server-Side Public Map & Hotspot Sync ---
  app.post('/api/reports/public-sync', syncRateLimiter, async (req, res) => {
    const mode = getFloodSenseMode();
    const { firestore } = resolveAdminServices();
    if (!firestore) {
      return res.status(mode === 'LIVE' ? 503 : 501).json({
        ok: false,
        reason: 'ADMIN_SDK_NOT_CONFIGURED',
        message: 'Server-side Firebase Admin SDK is not provisioned in this environment.',
      });
    }

    const authCheck = await verifyRequestAuth(req);
    if (!authCheck.ok) {
      return res.status(authCheck.status || 401).json({ error: authCheck.error || 'Authenticated Firebase user required.' });
    }

    const bodyReportId = req.body?.reportId || req.body?.report?.id;
    const submissionRequestId = req.body?.submissionRequestId;
    if (!bodyReportId || typeof bodyReportId !== 'string') {
      return res.status(400).json({ error: 'Valid reportId is required.' });
    }

    try {
      const reportRef = firestore.collection('reports').doc(bodyReportId);
      const reportSnap = await reportRef.get();
      if (!reportSnap.exists) {
        return res.status(404).json({ error: `Report ${bodyReportId} not found in Firestore.` });
      }

      const reportData = reportSnap.data() as FloodReport;
      if (authCheck.uid && reportData.reporterId !== authCheck.uid && authCheck.role !== 'officer') {
        return res.status(403).json({ error: 'Forbidden: you do not own this flood report.' });
      }

      if (!validateCoordinates(reportData.lat, reportData.lng)) {
        return res.status(400).json({ error: 'Stored report has invalid GPS coordinates.' });
      }

      if (
        reportData.publicSyncStatus === 'SYNCED' &&
        submissionRequestId &&
        reportData.submissionRequestId === submissionRequestId &&
        reportData.hotspotId
      ) {
        const hsSnap = await firestore.collection('hotspots').doc(reportData.hotspotId).get();
        return res.json({
          ok: true,
          idempotentHit: true,
          syncedReportId: reportData.id,
          hotspot: hsSnap.exists ? hsSnap.data() : null,
          isDuplicate: Boolean(reportData.isDuplicate),
          duplicateOfReportId: reportData.duplicateOfReportId || null,
          publicReport: buildSanitizedPublicReport(reportData),
        });
      }

      const cutoff24hIso = new Date(Date.now() - 24 * 60 * 60 * 1000).toISOString();
      const recentSnap = await firestore
        .collection('reports')
        .where('timestamp', '>=', cutoff24hIso)
        .get();

      const otherReports: FloodReport[] = [];
      recentSnap.docs.forEach((docSnap: any) => {
        const d = docSnap.data() as FloodReport;
        if (d.id && d.id !== reportData.id) {
          otherReports.push(d);
        }
      });

      let isDuplicate = Boolean(reportData.isDuplicate);
      let duplicateOfReportId = reportData.duplicateOfReportId;
      for (const prior of otherReports) {
        if (areReportsDuplicate(prior, reportData)) {
          isDuplicate = true;
          duplicateOfReportId = prior.id;
          break;
        }
      }

      const updatedTargetReport: FloodReport = {
        ...reportData,
        isDuplicate,
        ...(duplicateOfReportId ? { duplicateOfReportId } : {}),
      };

      const rainfallByArea: Record<string, number> = {};
      const areaCacheKey = `${Number(reportData.lat).toFixed(2)},${Number(reportData.lng).toFixed(2)}`;
      const areaWeather = weatherCache.get(areaCacheKey) || Array.from(weatherCache.values())[0];
      if (
        areaWeather &&
        areaWeather.data?.isLive &&
        areaWeather.data?.forecastAvailable &&
        typeof areaWeather.data?.expected3hRainfallMm === 'number' &&
        Number.isFinite(areaWeather.data.expected3hRainfallMm)
      ) {
        rainfallByArea['__default'] = areaWeather.data.expected3hRainfallMm;
      }

      const computedHotspots = clusterReports([updatedTargetReport, ...otherReports], undefined, rainfallByArea);
      const matchedHotspot =
        computedHotspots.find((h) => h.associatedReportIds.includes(updatedTargetReport.id)) ||
        clusterReports([updatedTargetReport], undefined, rainfallByArea)[0];

      updatedTargetReport.hotspotId = matchedHotspot.id;

      const sanitizedPublic = buildSanitizedPublicReport(updatedTargetReport);
      const syncedAt = new Date().toISOString();

      const batch = firestore.batch();
      batch.set(firestore.collection('public_reports').doc(updatedTargetReport.id), sanitizedPublic, { merge: true });
      for (const hs of computedHotspots) {
        batch.set(firestore.collection('hotspots').doc(hs.id), hs, { merge: true });
      }
      batch.set(
        reportRef,
        {
          hotspotId: matchedHotspot.id,
          isDuplicate,
          duplicateOfReportId: duplicateOfReportId || null,
          publicSyncStatus: 'SYNCED',
          publicSyncedAt: syncedAt,
        },
        { merge: true }
      );

      await batch.commit();

      return res.json({
        ok: true,
        syncedReportId: updatedTargetReport.id,
        hotspot: matchedHotspot,
        isDuplicate,
        duplicateOfReportId: duplicateOfReportId || null,
        publicReport: sanitizedPublic,
      });
    } catch (err: any) {
      return res.status(500).json({ ok: false, error: err?.message || 'Firestore Admin sync failed.' });
    }
  });

  return app;
}

async function startServer() {
  const app = createApiApp();
  const PORT = process.env.PORT ? parseInt(process.env.PORT, 10) : 3000;

  if (process.env.NODE_ENV === 'production' && fs.existsSync(path.resolve(__dirname, 'dist'))) {
    app.use(express.static(path.resolve(__dirname, 'dist')));
    app.get('*', (_req, res) => {
      res.sendFile(path.resolve(__dirname, 'dist', 'index.html'));
    });
  } else {
    const vite = await createViteServer({
      server: { middlewareMode: true },
      appType: 'spa',
    });
    app.use(vite.middlewares);
  }

  app.listen(PORT, '0.0.0.0', () => {
    console.log(`FloodSense EOC Server running on http://0.0.0.0:${PORT}`);
  });
}

const isMainEntry = path.resolve(process.argv[1] || '') === __filename;
if (isMainEntry) {
  startServer().catch((err) => {
    console.error('Fatal Server Error:', err);
    process.exit(1);
  });
}