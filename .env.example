# ==============================================================================
# FloodSense - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local development. Never commit `.env` with real
# credentials or service-account private keys to version control.

# ------------------------------------------------------------------------------
# Firebase Web SDK Client Configuration (Public Web Config for floodsense-72e55)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="your-firebase-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="floodsense-72e55.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="floodsense-72e55"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"
# Optional: Leave unset or set to "(default)" for default Cloud Firestore
VITE_FIREBASE_DATABASE_ID="(default)"
# Optional: Google Analytics Measurement ID (only initialized in browser contexts)
VITE_FIREBASE_MEASUREMENT_ID=""

# ------------------------------------------------------------------------------
# Server-Side Gemini Multimodal AI (NEVER expose with VITE_ prefix)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"
# Configurable multimodal model ID (default: gemini-3.8-flash; also supports gemini-4-hydrogen)
GEMINI_MODEL="gemini-3.8-flash"
# Per-attempt multimodal inference timeout in ms (60000-90000 recommended; default 75000)
GEMINI_TIMEOUT_MS="75000"
# Bounded retry count for transient 429/500/503/network errors (default 2)
GEMINI_MAX_RETRIES="2"

# ------------------------------------------------------------------------------
# Server-Side Firebase Admin SDK (Used by server.ts and officer authorization)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="floodsense-72e55"
FIREBASE_DATABASE_ID="(default)"
# Note: Image evidence is stored compressed in Cloud Firestore (Spark-plan compatible, no Cloud Storage bucket required).
# Option A: Inline JSON service-account credentials (single line JSON string)
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Option B: Path to service-account JSON file (recommended on Windows/Linux local dev)
GOOGLE_APPLICATION_CREDENTIALS=""

# ------------------------------------------------------------------------------
# Optional CORS Origin Whitelist (comma-separated)
# ------------------------------------------------------------------------------
CORS_ORIGIN="http://localhost:3000"
